# URL base do backend (Spring Boot). Copie este arquivo para .env se precisar mudar.
VITE_API_URL=http://localhost:8080

# O back-end aceita as datas 2 e 3 do agendamento vazias (null)? Hoje NÃO: ele exige as três.
# Enquanto for false, o front repete a última data informada nas opções em branco.
# Mude para true somente depois que o back-end for ajustado.
VITE_BACKEND_DATAS_OPCIONAIS=false
